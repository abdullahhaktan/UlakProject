# Copy to .env and adjust before `docker compose up`.

# --- SQL Server ---
SA_PASSWORD=Your_strong_Passw0rd!
DB_NAME=Ulak

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=ulak
MINIO_ROOT_PASSWORD=ulak-secret
MINIO_BUCKET=proofs
# Host ports (change if 9100/9101 are taken on your machine):
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
# Endpoint the API uses to reach MinIO inside the compose network:
MINIO_ENDPOINT=http://minio:9000
# Public endpoint browsers/mobile use to open presigned URLs (must match MINIO_API_PORT):
MINIO_PUBLIC_ENDPOINT=http://localhost:9100

# --- API ---
# HS256 signing key for JWT access tokens (use a long random value):
JWT_SIGNING_KEY=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ISSUER=ulak
JWT_AUDIENCE=ulak

# --- Web (ops panel) ---
API_BASE_URL=http://api:8080
API_KEY=panel-service-key-change-me
