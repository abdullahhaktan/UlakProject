<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Ulak.Mobile.Views.DeliveryDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Ulak.Mobile.ViewModels"
    xmlns:st="clr-namespace:Ulak.Mobile.Theme"
    x:DataType="vm:DeliveryDetailViewModel"
    Title="Teslimat"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- top bar -->
        <Grid Grid.Row="0" Style="{StaticResource TopBar}" ColumnDefinitions="Auto,*">
            <Border Style="{StaticResource IconButton}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBack" />
                </Border.GestureRecognizers>
                <Label Text="{x:Static st:Icon.ArrowLeft}" Style="{StaticResource Icon}" FontSize="22" />
            </Border>
            <Label Grid.Column="1" Text="Teslimat" Style="{StaticResource ScreenTitle}" VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="14">

                <Border Style="{StaticResource StripError}"
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}">
                    <Label Text="{Binding ErrorMessage}" FontSize="13.5"
                           TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}" />
                </Border>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />

                <VerticalStackLayout Spacing="14"
                                     IsVisible="{Binding Delivery, Converter={StaticResource IsNotNullConverter}}">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding Delivery.OrderRef}" Style="{StaticResource H1}" VerticalOptions="Center" />
                        <Border Grid.Column="1" Style="{StaticResource Badge}" VerticalOptions="Center"
                                BackgroundColor="{Binding Delivery.Status, Converter={StaticResource StatusTintConverter}}"
                                Stroke="{Binding Delivery.Status, Converter={StaticResource StatusColorConverter}}">
                            <Label Style="{StaticResource BadgeText}"
                                   Text="{Binding Delivery.Status, Converter={StaticResource StatusLabelConverter}}"
                                   TextColor="{Binding Delivery.Status, Converter={StaticResource StatusColorConverter}}" />
                        </Border>
                    </Grid>

                    <!-- recipient card -->
                    <Border Style="{StaticResource Card}" Padding="0">
                        <VerticalStackLayout>
                            <VerticalStackLayout Padding="14,12" Spacing="2">
                                <Label Text="ALICI" Style="{StaticResource FieldLabel}" />
                                <Label Text="{Binding Delivery.RecipientName}" Style="{StaticResource CardTitle}" />
                            </VerticalStackLayout>
                            <BoxView HeightRequest="1"
                                     Color="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}" />

                            <Grid Padding="14,12" ColumnDefinitions="*,Auto"
                                  IsVisible="{Binding Delivery.RecipientPhone, Converter={StaticResource IsNotNullConverter}}">
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label Text="TELEFON" Style="{StaticResource FieldLabel}" />
                                    <Label Text="{Binding Delivery.RecipientPhone}" Style="{StaticResource CardTitle}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="Ara" Style="{StaticResource SecondaryButton}"
                                        HeightRequest="44" Padding="18,0" WidthRequest="90"
                                        Command="{Binding CallRecipientCommand}" />
                            </Grid>
                            <BoxView HeightRequest="1"
                                     Color="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"
                                     IsVisible="{Binding Delivery.RecipientPhone, Converter={StaticResource IsNotNullConverter}}" />

                            <Grid Padding="14,12" ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label Text="ADRES" Style="{StaticResource FieldLabel}" />
                                    <Label Text="{Binding Delivery.AddressText}" Style="{StaticResource Body}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="Harita" Style="{StaticResource SecondaryButton}"
                                        HeightRequest="44" Padding="14,0" WidthRequest="90"
                                        Command="{Binding OpenMapCommand}"
                                        IsVisible="{Binding Delivery.Lat, Converter={StaticResource IsNotNullConverter}}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- teammate's delivery: read-only -->
                    <Border Style="{StaticResource Strip}" IsVisible="{Binding IsTeammateDelivery}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="{x:Static st:Icon.Package}" FontFamily="Phosphor" FontSize="18"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                            <Label Grid.Column="1" VerticalOptions="Center" FontSize="13"
                                   Text="Bu teslimat başka bir sürücüye atanmış — yalnızca görüntüleyebilirsin."
                                   TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                        </Grid>
                    </Border>

                    <!-- note -->
                    <Border Style="{StaticResource StripWarn}"
                            IsVisible="{Binding Delivery.Note, Converter={StaticResource IsNotNullConverter}}">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="NOT" Style="{StaticResource FieldLabel}"
                                   TextColor="{AppThemeBinding Light={StaticResource Warn}, Dark={StaticResource WarnDark}}" />
                            <Label Text="{Binding Delivery.Note}" FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource Warn}, Dark={StaticResource WarnDark}}" />
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- bottom CTA -->
        <Border Grid.Row="2" Padding="16,12,16,26" Stroke="Transparent"
                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                IsVisible="{Binding CanCaptureProof}">
            <VerticalStackLayout Spacing="8">
                <Button Text="Teslim aldım kanıtı"
                        Command="{Binding CapturePickupCommand}"
                        IsVisible="{Binding CanCapturePickup}"
                        ContentLayout="Left,8">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="Phosphor" Glyph="{x:Static st:Icon.Package}"
                                         Color="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
                    </Button.ImageSource>
                </Button>
                <Button Text="Teslim ettim kanıtı"
                        Command="{Binding CaptureDeliveryCommand}"
                        IsVisible="{Binding CanCaptureDelivery}"
                        ContentLayout="Left,8">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="Phosphor" Glyph="{x:Static st:Icon.Camera}"
                                         Color="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
                    </Button.ImageSource>
                </Button>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
