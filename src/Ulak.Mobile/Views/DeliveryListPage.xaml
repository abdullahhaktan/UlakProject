<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Ulak.Mobile.Views.DeliveryListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Ulak.Mobile.ViewModels"
    xmlns:dto="clr-namespace:Ulak.Shared.Deliveries;assembly=Ulak.Shared"
    x:DataType="vm:DeliveryListViewModel"
    Title="Bugünün teslimatları">

    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto" Padding="0,0,8,0">
            <Label VerticalOptions="Center" TextColor="White">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Teslimatlar  " FontAttributes="Bold" />
                        <Span Text="{Binding DriverName}" FontSize="12" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Button Grid.Column="1" Text="Çıkış" FontSize="12" Padding="8,2"
                    BackgroundColor="Transparent" TextColor="White"
                    Command="{Binding SignOutCommand}" />
        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <Label Grid.Row="0" Padding="16,8" BackgroundColor="#FFF3CD" TextColor="#664D03"
               Text="{Binding ErrorMessage}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}" />

        <Grid Grid.Row="1" Padding="16,8" ColumnDefinitions="*,Auto" BackgroundColor="#CFE2FF"
              IsVisible="{Binding HasQueued}">
            <Label VerticalOptions="Center" TextColor="#084298"
                   Text="{Binding QueuedCount, StringFormat='{0} kayıt gönderilmeyi bekliyor'}" />
            <Button Grid.Column="1" Text="Şimdi gönder" FontSize="12" Padding="10,2"
                    Command="{Binding SyncNowCommand}" />
        </Grid>

        <Label Grid.Row="2" Padding="16,8" BackgroundColor="#F8D7DA" TextColor="#842029"
               IsVisible="{Binding HasFailed}"
               Text="{Binding FailedCount, StringFormat='{0} kayıt gönderilemedi — internet bağlantısını kontrol edin'}" />

        <RefreshView Grid.Row="3" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsRefreshing}">
            <CollectionView ItemsSource="{Binding Deliveries}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <ContentView Padding="24">
                        <Label Text="Bugün için atanmış teslimat yok." HorizontalOptions="Center" TextColor="Gray" />
                    </ContentView>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:DeliveryListItem">
                        <Grid Padding="16,12" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.OpenDeliveryCommand}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>

                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding OrderRef}" FontAttributes="Bold" />
                            <Label Grid.Row="1" Grid.Column="0" Text="{Binding RecipientName}" />
                            <Label Grid.Row="2" Grid.Column="0" Text="{Binding AddressText}" FontSize="12" TextColor="Gray" LineBreakMode="TailTruncation" />

                            <Label Grid.Row="0" Grid.Column="1" Grid.RowSpan="3" VerticalOptions="Center"
                                   FontSize="12" FontAttributes="Bold"
                                   Text="{Binding Status}"
                                   TextColor="{Binding Status, Converter={StaticResource StatusColorConverter}}" />
                            <Label Grid.Row="0" Grid.Column="1" Grid.RowSpan="3" VerticalOptions="End" HorizontalOptions="End"
                                   Text="✓" TextColor="SeaGreen" FontSize="16"
                                   IsVisible="{Binding HasProof}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <ActivityIndicator Grid.Row="3" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                           VerticalOptions="Start" HorizontalOptions="Center" Margin="0,16" />
    </Grid>
</ContentPage>
