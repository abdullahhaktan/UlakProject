<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Ulak.Mobile.Views.ChangePasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Ulak.Mobile.ViewModels"
    xmlns:st="clr-namespace:Ulak.Mobile.Theme"
    x:DataType="vm:ChangePasswordViewModel"
    Title="Şifre değiştir"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="22,64,22,28" Spacing="18" VerticalOptions="Center">

            <!-- header -->
            <VerticalStackLayout Spacing="12">
                <Border WidthRequest="56" HeightRequest="56" Padding="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                        Stroke="Transparent">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Label Text="{x:Static st:Icon.Package}" FontFamily="Phosphor" FontSize="26"
                           TextColor="{StaticResource White}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Spacing="2">
                    <Label Text="Şifrenizi belirleyin" Style="{StaticResource H1}" />
                    <Label Text="Geçici şifreyle giriş yaptınız. Devam etmek için kendi şifrenizi oluşturun."
                           Style="{StaticResource Secondary}" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- current password (only when not carried over from login) -->
            <VerticalStackLayout Spacing="6" IsVisible="{Binding CurrentEditable}">
                <Label Text="MEVCUT ŞİFRE" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputBorder}">
                    <Entry Placeholder="Geçici şifre" IsPassword="True" Text="{Binding CurrentPassword}" />
                </Border>
            </VerticalStackLayout>

            <!-- new password -->
            <VerticalStackLayout Spacing="6">
                <Label Text="YENİ ŞİFRE" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputBorder}">
                    <Entry Placeholder="En az 6 karakter" IsPassword="True" Text="{Binding NewPassword}" />
                </Border>
            </VerticalStackLayout>

            <!-- confirm -->
            <VerticalStackLayout Spacing="6">
                <Label Text="YENİ ŞİFRE (TEKRAR)" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputBorder}">
                    <Entry Placeholder="Yeni şifreyi tekrar girin" IsPassword="True" Text="{Binding ConfirmPassword}" />
                </Border>
            </VerticalStackLayout>

            <!-- error -->
            <Border Style="{StaticResource StripError}"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                    <Label Text="{x:Static st:Icon.WarningCircle}" FontFamily="Phosphor" FontSize="18"
                           TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                           VerticalOptions="Start" />
                    <Label Grid.Column="1" Text="{Binding ErrorMessage}" FontSize="13.5"
                           TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}" />
                </Grid>
            </Border>

            <!-- submit -->
            <Button Text="Şifreyi kaydet"
                    Command="{Binding SubmitCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />

            <Button Text="Çıkış yap" Style="{StaticResource GhostButton}"
                    Command="{Binding SignOutCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
