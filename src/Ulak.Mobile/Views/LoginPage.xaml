<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Ulak.Mobile.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Ulak.Mobile.ViewModels"
    xmlns:st="clr-namespace:Ulak.Mobile.Theme"
    x:DataType="vm:LoginViewModel"
    Title="Giriş"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="22,64,22,28" Spacing="18" VerticalOptions="Center">

            <!-- brand -->
            <VerticalStackLayout Spacing="12">
                <Border WidthRequest="56" HeightRequest="56" Padding="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                        Stroke="Transparent">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Label Text="{x:Static st:Icon.Package}" FontFamily="Phosphor" FontSize="26"
                           TextColor="{StaticResource White}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Spacing="2">
                    <Label Text="Ulak" Style="{StaticResource H1}" />
                    <Label Text="Sürücü uygulaması" Style="{StaticResource Secondary}" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- phone -->
            <VerticalStackLayout Spacing="6">
                <Label Text="TELEFON" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputBorder}">
                    <Entry Placeholder="+90 5xx xxx xx xx" Keyboard="Telephone" Text="{Binding Phone}" />
                </Border>
            </VerticalStackLayout>

            <!-- password -->
            <VerticalStackLayout Spacing="6">
                <Label Text="ŞİFRE" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputBorder}">
                    <Entry x:Name="PasswordEntry" Placeholder="Şifre" IsPassword="True" Text="{Binding Password}" />
                </Border>
            </VerticalStackLayout>

            <!-- advanced settings (collapsible) -->
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*,Auto" x:Name="AdvancedToggle">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnToggleAdvanced" />
                    </Grid.GestureRecognizers>
                    <Label Text="Gelişmiş ayarlar" Style="{StaticResource Secondary}" VerticalOptions="Center" />
                    <Label x:Name="AdvancedCaret" Grid.Column="1" Text="{x:Static st:Icon.CaretDown}"
                           Style="{StaticResource Icon}" FontSize="16"
                           TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                </Grid>

                <VerticalStackLayout x:Name="AdvancedSection" Spacing="6" IsVisible="False">
                    <Label Text="API ADRESİ" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource InputBorder}" MinimumHeightRequest="48">
                        <Entry Placeholder="http://185.187.169.151:8080" Text="{Binding ApiBaseUrl}" FontSize="14" />
                    </Border>
                    <Label Text="Demo: +905551112233 / Driver123!" Style="{StaticResource Secondary}" FontSize="12" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- error -->
            <Border Style="{StaticResource StripError}"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                    <Label Text="{x:Static st:Icon.WarningCircle}" FontFamily="Phosphor" FontSize="18"
                           TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                           VerticalOptions="Start" />
                    <Label Grid.Column="1" Text="{Binding ErrorMessage}" FontSize="13.5"
                           TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}" />
                </Grid>
            </Border>

            <!-- submit -->
            <Button Text="Giriş yap"
                    Command="{Binding SignInCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
