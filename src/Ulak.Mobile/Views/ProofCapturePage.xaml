<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Ulak.Mobile.Views.ProofCapturePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Ulak.Mobile.ViewModels"
    xmlns:controls="clr-namespace:Ulak.Mobile.Controls"
    x:DataType="vm:ProofCaptureViewModel"
    Title="Teslimat kanıtı">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label FontSize="18" FontAttributes="Bold">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding OrderRef}" />
                        <Span Text="  " />
                        <Span Text="{Binding RecipientName}" FontSize="14" FontAttributes="None" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <!-- Photos -->
            <Label Text="Fotoğraflar" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding Photos}" HeightRequest="110">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CapturedPhoto">
                        <Grid WidthRequest="100" HeightRequest="100">
                            <Image Source="{Binding Preview}" Aspect="AspectFill" />
                            <Button Text="✕" FontSize="12" Padding="0" WidthRequest="26" HeightRequest="26"
                                    BackgroundColor="#CC000000" TextColor="White"
                                    HorizontalOptions="End" VerticalOptions="Start"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.RemovePhotoCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Button Text="Fotoğraf ekle" Command="{Binding AddPhotoCommand}" IsEnabled="{Binding CanAddPhoto}" />

            <!-- Signature -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="İmza" FontAttributes="Bold" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Temizle" FontSize="12" Padding="10,2" Clicked="OnClearSignature" />
            </Grid>
            <Border Stroke="LightGray" StrokeThickness="1">
                <controls:SignaturePadView x:Name="SignaturePad" />
            </Border>

            <Entry Placeholder="Teslim alan kişi (ad soyad)" Text="{Binding RecipientSignedName}" />

            <!-- Failed -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Teslim edilemedi" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding IsFailed}" />
            </Grid>
            <Entry Placeholder="Başarısızlık nedeni" Text="{Binding FailureReason}" IsVisible="{Binding IsFailed}" />

            <Label Text="{Binding ErrorMessage}" TextColor="Red"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}" />

            <Button Text="Kaydet" BackgroundColor="#0D6EFD" TextColor="White"
                    Command="{Binding SubmitCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
