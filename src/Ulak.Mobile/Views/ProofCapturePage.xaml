<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Ulak.Mobile.Views.ProofCapturePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Ulak.Mobile.ViewModels"
    xmlns:st="clr-namespace:Ulak.Mobile.Theme"
    xmlns:controls="clr-namespace:Ulak.Mobile.Controls"
    x:DataType="vm:ProofCaptureViewModel"
    Title="Teslimat kanıtı"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- top bar -->
        <Grid Grid.Row="0" Style="{StaticResource TopBar}" ColumnDefinitions="Auto,*">
            <Border Style="{StaticResource IconButton}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBack" />
                </Border.GestureRecognizers>
                <Label Text="{x:Static st:Icon.ArrowLeft}" Style="{StaticResource Icon}" FontSize="22" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label Text="{Binding ScreenTitle}" Style="{StaticResource ScreenTitle}" FontSize="17" />
                <Label Style="{StaticResource Secondary}" FontSize="12">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding OrderRef}" />
                            <Span Text=" · " />
                            <Span Text="{Binding RecipientName}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,18" Spacing="20">

                <!-- photos -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="FOTOĞRAFLAR" Style="{StaticResource FieldLabel}" />
                    <CollectionView ItemsSource="{Binding Photos}" HeightRequest="92">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CapturedPhoto">
                                <Border WidthRequest="92" HeightRequest="92" Padding="0" Stroke="Transparent">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Grid>
                                        <Image Source="{Binding Preview}" Aspect="AspectFill" />
                                        <Border WidthRequest="26" HeightRequest="26" Padding="0"
                                                HorizontalOptions="End" VerticalOptions="Start" Margin="0,-6,-6,0"
                                                BackgroundColor="{StaticResource TextColor}" Stroke="{StaticResource Bg}"
                                                StrokeThickness="2">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="999" />
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.RemovePhotoCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="{x:Static st:Icon.X}" FontFamily="Phosphor" FontSize="12"
                                                   TextColor="{StaticResource White}"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Button Text="Fotoğraf ekle" Style="{StaticResource SecondaryButton}"
                            Command="{Binding AddPhotoCommand}" IsEnabled="{Binding CanAddPhoto}"
                            ContentLayout="Left,8">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="Phosphor" Glyph="{x:Static st:Icon.CameraPlus}"
                                             Color="{AppThemeBinding Light={StaticResource TextColor}, Dark={StaticResource TextColorDark}}" />
                        </Button.ImageSource>
                    </Button>
                </VerticalStackLayout>

                <!-- signature -->
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="İMZA" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Temizle" Style="{StaticResource GhostButton}" Clicked="OnClearSignature" />
                    </Grid>
                    <Border Style="{StaticResource Card}" Padding="0" HeightRequest="180">
                        <controls:SignaturePadView x:Name="SignaturePad" />
                    </Border>
                </VerticalStackLayout>

                <!-- recipient name -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding RecipientFieldLabel}" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource InputBorder}">
                        <Entry Placeholder="Ad soyad" Text="{Binding RecipientSignedName}" />
                    </Border>
                </VerticalStackLayout>

                <!-- failed toggle -->
                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding FailedToggleLabel}" Style="{StaticResource CardTitle}" FontSize="15" />
                            <Label Text="Adres yanlış, alıcı yok vb." Style="{StaticResource Secondary}" FontSize="12" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding IsFailed}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsFailed}">
                    <Label Text="BAŞARISIZLIK NEDENİ" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource Card}" Padding="14,4">
                        <Editor Placeholder="Ne oldu?" Text="{Binding FailureReason}" AutoSize="TextChanges"
                                MinimumHeightRequest="80" />
                    </Border>
                </VerticalStackLayout>

                <Border Style="{StaticResource StripError}"
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}">
                    <Label Text="{Binding ErrorMessage}" FontSize="13.5"
                           TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}" />
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- bottom -->
        <Border Grid.Row="2" Padding="16,12,16,26" Stroke="Transparent"
                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Text="{x:Static st:Icon.CloudSlash}" FontFamily="Phosphor" FontSize="15"
                           VerticalOptions="Start"
                           TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                    <Label Grid.Column="1" FontSize="12" Style="{StaticResource Secondary}"
                           Text="İnternet yoksa kayıt telefonda saklanır, bağlantı gelince otomatik gönderilir." />
                </Grid>
                <Button Text="Kaydet"
                        Command="{Binding SubmitCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                        ContentLayout="Left,8">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="Phosphor" Glyph="{x:Static st:Icon.FloppyDisk}"
                                         Color="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
                    </Button.ImageSource>
                </Button>
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
