<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
      Ulak "Nocturne" design tokens. 13 semantic roles, each with a light and a
      dark value. Screens paint from these only — never a raw hex. Retuning the
      theme = changing the values here.
      Android status/nav bar colours: Platforms/Android/Resources/values/colors.xml
    -->

    <Color x:Key="Bg">#E9ECF7</Color>
    <Color x:Key="BgDark">#161826</Color>

    <Color x:Key="Surface">#F7F8FE</Color>
    <Color x:Key="SurfaceDark">#232532</Color>

    <Color x:Key="TextColor">#292B31</Color>
    <Color x:Key="TextColorDark">#E9E9ED</Color>

    <Color x:Key="Muted">#595D6C</Color>
    <Color x:Key="MutedDark">#B2B6CA</Color>

    <Color x:Key="Line">#CFD3E5</Color>
    <Color x:Key="LineDark">#3F424D</Color>

    <Color x:Key="Accent">#5D5294</Color>
    <Color x:Key="AccentDark">#B5ABFC</Color>

    <Color x:Key="AccentTint">#EBE9FE</Color>
    <Color x:Key="AccentTintDark">#2B2741</Color>

    <Color x:Key="Ok">#3F6B4E</Color>
    <Color x:Key="OkDark">#8FD0A4</Color>
    <Color x:Key="OkTint">#E3EFE6</Color>
    <Color x:Key="OkTintDark">#22322A</Color>

    <Color x:Key="Warn">#8A6A1F</Color>
    <Color x:Key="WarnDark">#E0C078</Color>
    <Color x:Key="WarnTint">#F7EFD9</Color>
    <Color x:Key="WarnTintDark">#332D1C</Color>

    <Color x:Key="Error">#A8443C</Color>
    <Color x:Key="ErrorDark">#F0A49C</Color>
    <Color x:Key="ErrorTint">#F8E5E3</Color>
    <Color x:Key="ErrorTintDark">#3A2523</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Ink">#1B2A6B</Color>

    <!-- Compat aliases: MAUI's built-in control templates / visual states look
         these up by name. Kept pointing at our tokens so nothing falls back to
         the stock purple. -->
    <Color x:Key="Primary">#5D5294</Color>
    <Color x:Key="PrimaryDark">#B5ABFC</Color>
    <Color x:Key="Gray100">#E9ECF7</Color>
    <Color x:Key="Gray200">#CFD3E5</Color>
    <Color x:Key="Gray300">#B2B6CA</Color>
    <Color x:Key="Gray400">#8A8B93</Color>
    <Color x:Key="Gray500">#595D6C</Color>
    <Color x:Key="Gray600">#3F424D</Color>
    <Color x:Key="Gray900">#232532</Color>
    <Color x:Key="Gray950">#161826</Color>

</ResourceDictionary>
