<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ================= implicit ================= -->

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Bg}, Dark={StaticResource BgDark}}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextColor}, Dark={StaticResource TextColorDark}}" />
        <Setter Property="LineHeight" Value="1.35" />
    </Style>

    <Style TargetType="Span">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextColor}, Dark={StaticResource TextColorDark}}" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextColor}, Dark={StaticResource TextColorDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextColor}, Dark={StaticResource TextColorDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
        <Setter Property="ThumbColor" Value="{StaticResource White}" />
    </Style>

    <Style TargetType="Button" x:Key="ButtonBase">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <!-- primary: outlined accent -->
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentTint}, Dark={StaticResource AccentTintDark}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
        <Setter Property="BorderWidth" Value="1.5" />
        <Setter Property="HeightRequest" Value="56" />
    </Style>

    <Style TargetType="CollectionView">
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource TextColor}, Dark={StaticResource TextColorDark}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource TextColor}, Dark={StaticResource TextColorDark}}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
    </Style>

    <!-- ================= text roles ================= -->

    <Style TargetType="Label" x:Key="H1">
        <Setter Property="FontFamily" Value="InterExtraBold" />
        <Setter Property="FontSize" Value="26" />
    </Style>

    <Style TargetType="Label" x:Key="ScreenTitle">
        <Setter Property="FontFamily" Value="InterExtraBold" />
        <Setter Property="FontSize" Value="19" />
    </Style>

    <Style TargetType="Label" x:Key="CardTitle">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style TargetType="Label" x:Key="Body">
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="Label" x:Key="Secondary">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
    </Style>

    <Style TargetType="Label" x:Key="FieldLabel">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
        <Setter Property="CharacterSpacing" Value="0.6" />
    </Style>

    <Style TargetType="Label" x:Key="Mono">
        <Setter Property="FontFamily" Value="InterSemiBold" />
    </Style>

    <!-- ================= icons ================= -->

    <Style TargetType="Label" x:Key="Icon">
        <Setter Property="FontFamily" Value="Phosphor" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextColor}, Dark={StaticResource TextColorDark}}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="LineHeight" Value="1" />
    </Style>

    <!-- tap target wrapper for an icon: 44x44, transparent -->
    <Style TargetType="Border" x:Key="IconButton">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- ================= surfaces ================= -->

    <Style TargetType="Border" x:Key="Card">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="12" />
        </Setter>
    </Style>

    <Style TargetType="Border" x:Key="InputBorder">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinimumHeightRequest" Value="54" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="12" />
        </Setter>
    </Style>

    <!-- ================= buttons (keyed) ================= -->

    <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextColor}, Dark={StaticResource TextColorDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="HeightRequest" Value="52" />
    </Style>

    <Style TargetType="Button" x:Key="GhostButton" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="Padding" Value="10,0" />
    </Style>

    <Style TargetType="Button" x:Key="PillWarn" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Warn}, Dark={StaticResource WarnDark}}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,0" />
    </Style>

    <Style TargetType="Button" x:Key="PillError" BasedOn="{StaticResource PillWarn}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}" />
    </Style>

    <!-- ================= badges (pill wrappers) ================= -->

    <Style TargetType="Border" x:Key="Badge">
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="999" />
        </Setter>
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

    <Style TargetType="Label" x:Key="BadgeText">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="0.5" />
    </Style>

    <!-- ================= sync strips ================= -->

    <Style TargetType="Border" x:Key="Strip">
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="12,11" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="12" />
        </Setter>
    </Style>

    <Style TargetType="Border" x:Key="StripWarn" BasedOn="{StaticResource Strip}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource WarnTint}, Dark={StaticResource WarnTintDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Warn}, Dark={StaticResource WarnDark}}" />
    </Style>

    <Style TargetType="Border" x:Key="StripError" BasedOn="{StaticResource Strip}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ErrorTint}, Dark={StaticResource ErrorTintDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}" />
    </Style>

    <Style TargetType="Border" x:Key="StripOk" BasedOn="{StaticResource Strip}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource OkTint}, Dark={StaticResource OkTintDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Ok}, Dark={StaticResource OkDark}}" />
    </Style>

    <!-- top bar shared by the in-page headers -->
    <Style TargetType="Grid" x:Key="TopBar">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Padding" Value="6,54,12,12" />
        <Setter Property="ColumnSpacing" Value="6" />
    </Style>

</ResourceDictionary>
