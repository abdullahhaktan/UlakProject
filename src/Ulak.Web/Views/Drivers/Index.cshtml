@model IReadOnlyList<Ulak.Shared.Admin.DriverOption>
@{
    ViewData["Title"] = L["Nav_Drivers"].Value;
}

<div class="page-head">
    <div>
        <h1>@L["Nav_Drivers"]</h1>
        <p class="sub">@string.Format(L["Drivers_Subtitle"].Value, Model.Count)</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-primary" id="btn-new-driver" type="button">
            <svg viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            @L["Drivers_Add"]
        </button>
    </div>
</div>

<div class="table-card">
    <div class="table-scroll">
        <table class="data">
            <thead><tr><th>@L["Drivers_Name"]</th><th>@L["Delivery_Phone"]</th></tr></thead>
            <tbody id="drivers-body">
                @if (Model.Count == 0)
                {
                    <tr><td colspan="2" class="cell-empty">@L["Drivers_Empty"]</td></tr>
                }
                @foreach (var d in Model)
                {
                    <tr>
                        <td><div class="driver-name"><span class="dot"></span><span class="cell-primary">@d.Name</span></div></td>
                        <td class="cell-mono">@d.Phone</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal-backdrop" id="modal-driver">
    <div class="modal" role="dialog" aria-modal="true">
        <div class="modal-head">
            <h3>@L["Drivers_Add"]</h3>
            <button class="icon-btn" type="button" data-close aria-label="@L["Common_Cancel"]">
                <svg viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            </button>
        </div>
        <div class="modal-body">
            <div id="d-error" class="alert alert-danger hidden"></div>
            <div id="d-form">
                <label class="field-block" style="margin-bottom:12px"><span>@L["Drivers_Name"]</span><input id="d-name" placeholder="@L["Drivers_NamePlaceholder"]" /></label>
                <label class="field-block"><span>@L["Delivery_Phone"]</span>
                    <div class="phone-input"><span class="phone-prefix">+90</span><input id="d-phone" placeholder="5xx xxx xx xx" /></div>
                </label>
            </div>
            <div id="d-result" class="alert alert-ok hidden">
                <strong>@L["Drivers_Created"]</strong><br />
                @L["Drivers_TempHint"]
                <div class="temp-pass" id="d-temp" style="margin-top:8px"></div>
            </div>
        </div>
        <div class="modal-foot">
            <button class="btn btn-ghost" type="button" data-close>@L["Common_Close"]</button>
            <button class="btn btn-primary" id="d-save" type="button">@L["Drivers_Create"]</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var token = Ulak.csrf();
            var modal = Ulak.modal('modal-driver');
            var i18n = { error: '@L["Common_Error"]', required: '@L["Drivers_Required"]', create: '@L["Drivers_Create"]' };

            document.getElementById('btn-new-driver').addEventListener('click', function () {
                document.getElementById('d-error').classList.add('hidden');
                document.getElementById('d-result').classList.add('hidden');
                document.getElementById('d-form').classList.remove('hidden');
                document.getElementById('d-name').value = '';
                document.getElementById('d-phone').value = '';
                var save = document.getElementById('d-save');
                save.disabled = false; save.textContent = i18n.create; save.classList.remove('hidden');
                modal.open();
            });

            document.getElementById('d-save').addEventListener('click', function () {
                var phone = document.getElementById('d-phone').value.trim();
                if (phone && phone.charAt(0) !== '+') phone = '+90' + phone.replace(/[^0-9]/g, '');
                var body = { name: document.getElementById('d-name').value.trim(), phone: phone };
                var err = document.getElementById('d-error');
                if (!body.name || !body.phone) {
                    err.textContent = i18n.required; err.classList.remove('hidden');
                    return;
                }
                var save = document.getElementById('d-save');
                save.disabled = true;
                jQuery.ajax({
                    url: '@Url.Action("Create", "Drivers")', method: 'POST', contentType: 'application/json',
                    headers: { 'RequestVerificationToken': token }, data: JSON.stringify(body)
                }).done(function (res) {
                    err.classList.add('hidden');
                    document.getElementById('d-form').classList.add('hidden');
                    document.getElementById('d-temp').textContent = res.tempPassword;
                    document.getElementById('d-result').classList.remove('hidden');
                    save.classList.add('hidden');
                    var tbody = document.getElementById('drivers-body');
                    var empty = tbody.querySelector('.cell-empty');
                    if (empty) empty.closest('tr').remove();
                    var tr = document.createElement('tr');
                    tr.innerHTML = '<td><div class="driver-name"><span class="dot"></span><span class="cell-primary">' +
                        Ulak.esc(res.name) + '</span></div></td><td class="cell-mono">' + Ulak.esc(res.phone) + '</td>';
                    tbody.appendChild(tr);
                }).fail(function (x) {
                    save.disabled = false;
                    err.textContent = (x.responseJSON && x.responseJSON.message) || i18n.error;
                    err.classList.remove('hidden');
                });
            });
        })();
    </script>
}
