@{
    ViewData["Title"] = L["Nav_Deliveries"].Value;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@L["Deliveries_Title"]</h1>
    <button class="btn btn-primary" id="btn-new">@L["Deliveries_New"]</button>
</div>

<div class="card mb-3"><div class="card-body">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label small">@L["Common_Search"]</label>
            <input type="text" id="f-search" class="form-control form-control-sm" placeholder="@L["Deliveries_SearchHint"]" />
        </div>
        <div class="col-md-3">
            <label class="form-label small">@L["Common_Status"]</label>
            <select id="f-status" class="form-select form-select-sm">
                <option value="">@L["Common_All"]</option>
                <option value="Pending">@L["Status_Pending"]</option>
                <option value="Delivered">@L["Status_Delivered"]</option>
                <option value="Failed">@L["Status_Failed"]</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small">@L["Common_Driver"]</label>
            <select id="f-driver" class="form-select form-select-sm"><option value="">@L["Common_All"]</option></select>
        </div>
        <div class="col-md-2">
            <button class="btn btn-sm btn-outline-secondary w-100" id="btn-filter">@L["Common_Apply"]</button>
        </div>
    </div>
</div></div>

<div id="grid"></div>

<!-- New delivery modal -->
<div class="modal fade" id="modal-new" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@L["Deliveries_New"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="new-error" class="alert alert-danger d-none py-2"></div>
                <div class="mb-2"><label class="form-label small">@L["Delivery_OrderRef"]</label><input id="n-orderRef" class="form-control form-control-sm" /></div>
                <div class="mb-2"><label class="form-label small">@L["Delivery_Recipient"]</label><input id="n-recipientName" class="form-control form-control-sm" /></div>
                <div class="mb-2"><label class="form-label small">@L["Delivery_Phone"]</label><input id="n-recipientPhone" class="form-control form-control-sm" /></div>
                <div class="mb-2"><label class="form-label small">@L["Delivery_Address"]</label><textarea id="n-addressText" class="form-control form-control-sm" rows="2"></textarea></div>
                <div class="mb-2"><label class="form-label small">@L["Delivery_Note"]</label><input id="n-note" class="form-control form-control-sm" /></div>
                <div class="mb-2"><label class="form-label small">@L["Common_Driver"]</label><select id="n-driver" class="form-select form-select-sm"><option value="">—</option></select></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L["Common_Cancel"]</button>
                <button type="button" class="btn btn-primary" id="n-save">@L["Common_Save"]</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const antiForgery = '@Html.AntiForgeryToken()';
        const token = $(antiForgery).val();
        const i18n = {
            assign: '@L["Deliveries_Assign"]', assigned: '@L["Deliveries_Assigned"]',
            saved: '@L["Common_Saved"]'
        };
        let drivers = [];

        function currentFilters() {
            return {
                search: $("#f-search").val() || null,
                status: $("#f-status").val() || null,
                driverId: $("#f-driver").val() || null
            };
        }

        const store = new DevExpress.data.CustomStore({
            key: "id",
            load(opts) {
                const sort = (opts.sort && opts.sort[0]) || { selector: "createdAtUtc", desc: true };
                return $.getJSON("@Url.Action("Data", "Deliveries")", $.extend(currentFilters(), {
                    skip: opts.skip || 0, take: opts.take || 20,
                    sort: sort.selector, desc: !!sort.desc
                })).then(r => ({ data: r.data, totalCount: r.totalCount }));
            }
        });

        const grid = $("#grid").dxDataGrid({
            dataSource: store,
            remoteOperations: { paging: true, sorting: true },
            columnAutoWidth: true, showBorders: true, hoverStateEnabled: true,
            paging: { pageSize: 20 },
            pager: { visible: true, showInfo: true, showNavigationButtons: true },
            columns: [
                { dataField: "orderRef", caption: "@L["Delivery_OrderRef"]" },
                { dataField: "recipientName", caption: "@L["Delivery_Recipient"]" },
                { dataField: "addressText", caption: "@L["Delivery_Address"]" },
                { dataField: "status", caption: "@L["Common_Status"]", width: 110,
                  cellTemplate(c, o) {
                      const map = { Pending: "secondary", Delivered: "success", Failed: "danger" };
                      c.append(`<span class="badge text-bg-${map[o.value] || 'secondary'}">${o.value}</span>`);
                  } },
                { dataField: "assignedDriverName", caption: "@L["Common_Driver"]" },
                { dataField: "hasProof", caption: "@L["Delivery_HasProof"]", dataType: "boolean", width: 90 },
                { dataField: "createdAtUtc", caption: "@L["Common_CreatedAt"]", dataType: "datetime", width: 150 },
                {
                    type: "buttons", width: 110,
                    buttons: [{
                        hint: i18n.assign, icon: "user",
                        visible: (e) => e.row.data.status === "Pending",
                        onClick(e) { assignDialog(e.row.data); }
                    }]
                }
            ]
        }).dxDataGrid("instance");

        function assignDialog(row) {
            const driverId = window.prompt(
                i18n.assign + " — " + row.orderRef + "\n" + drivers.map(d => d.id + " = " + d.name).join("\n"),
                row.assignedDriverId || "");
            if (!driverId) return;
            $.ajax({
                url: "@Url.Action("Assign", "Deliveries")?id=" + row.id,
                method: "POST", contentType: "application/json",
                headers: { "RequestVerificationToken": token },
                data: JSON.stringify({ driverId: parseInt(driverId, 10) })
            }).done(() => { DevExpress.ui.notify(i18n.assigned, "success", 2000); grid.refresh(); })
              .fail(x => DevExpress.ui.notify((x.responseJSON && x.responseJSON.message) || "Error", "error", 3000));
        }

        $("#btn-filter").on("click", () => grid.refresh());
        $("#f-search").on("keydown", e => { if (e.key === "Enter") grid.refresh(); });

        $.getJSON("@Url.Action("Drivers", "Deliveries")").done(list => {
            drivers = list;
            const opts = list.map(d => `<option value="${d.id}">${d.name}</option>`).join("");
            $("#f-driver, #n-driver").append(opts);
        });

        const modal = new bootstrap.Modal("#modal-new");
        $("#btn-new").on("click", () => { $("#new-error").addClass("d-none"); $("#modal-new input,#modal-new textarea").val(""); modal.show(); });
        $("#n-save").on("click", () => {
            const body = {
                orderRef: $("#n-orderRef").val(), recipientName: $("#n-recipientName").val(),
                recipientPhone: $("#n-recipientPhone").val() || null, addressText: $("#n-addressText").val(),
                note: $("#n-note").val() || null,
                assignedDriverId: $("#n-driver").val() ? parseInt($("#n-driver").val(), 10) : null
            };
            $.ajax({
                url: "@Url.Action("Create", "Deliveries")", method: "POST", contentType: "application/json",
                headers: { "RequestVerificationToken": token }, data: JSON.stringify(body)
            }).done(() => { modal.hide(); DevExpress.ui.notify(i18n.saved, "success", 2000); grid.refresh(); })
              .fail(x => $("#new-error").removeClass("d-none").text((x.responseJSON && x.responseJSON.message) || "Error"));
        });
    </script>
}
