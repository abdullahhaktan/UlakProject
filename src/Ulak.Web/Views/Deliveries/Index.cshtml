@{
    ViewData["Title"] = L["Deliveries_Title"].Value;
}

<div class="page-head">
    <div>
        <h1>@L["Deliveries_Title"]</h1>
        <p class="sub">@L["Deliveries_Subtitle"]</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-primary" id="btn-new" type="button">
            <svg viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            @L["Deliveries_New"]
        </button>
    </div>
</div>

<div class="filter-bar">
    <label class="field grow"><span>@L["Common_Search"]</span><input type="text" id="f-search" placeholder="@L["Deliveries_SearchHint"]" /></label>
    <label class="field"><span>@L["Common_Status"]</span>
        <select id="f-status">
            <option value="">@L["Common_All"]</option>
            <option value="Pending">@L["Status_Pending"]</option>
            <option value="Delivered">@L["Status_Delivered"]</option>
            <option value="Failed">@L["Status_Failed"]</option>
        </select>
    </label>
    <label class="field"><span>@L["Common_Driver"]</span>
        <select id="f-driver"><option value="">@L["Common_All"]</option></select>
    </label>
    <button class="btn btn-outline" id="btn-filter" type="button">@L["Common_Apply"]</button>
</div>

<div class="table-card">
    <div class="table-scroll">
        <table class="data">
            <thead><tr>
                <th>@L["Delivery_OrderRef"]</th><th>@L["Delivery_Recipient"]</th><th>@L["Delivery_Address"]</th>
                <th>@L["Common_Status"]</th><th>@L["Common_Driver"]</th><th>@L["Delivery_HasProof"]</th><th>@L["Common_CreatedAt"]</th>
            </tr></thead>
            <tbody id="deliveriesBody"></tbody>
        </table>
    </div>
    <div class="table-foot">
        <span class="count"></span>
        <div class="pager"></div>
    </div>
</div>

<div class="modal-backdrop" id="modal-new">
    <div class="modal" role="dialog" aria-modal="true">
        <div class="modal-head">
            <h3>@L["Deliveries_New"]</h3>
            <button class="icon-btn" type="button" data-close aria-label="@L["Common_Cancel"]">
                <svg viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            </button>
        </div>
        <div class="modal-body">
            <div id="new-error" class="alert alert-danger hidden"></div>
            <label class="field-block"><span>@L["Delivery_OrderRef"]</span><input id="n-orderRef" /></label>
            <label class="field-block"><span>@L["Delivery_Recipient"]</span><input id="n-recipientName" /></label>
            <label class="field-block"><span>@L["Delivery_Phone"]</span><input id="n-recipientPhone" /></label>
            <label class="field-block"><span>@L["Delivery_Address"]</span><textarea id="n-addressText" rows="2"></textarea></label>
            <label class="field-block"><span>@L["Delivery_Note"]</span><input id="n-note" /></label>
            <label class="field-block"><span>@L["Common_Driver"]</span><select id="n-driver"><option value="">—</option></select></label>
        </div>
        <div class="modal-foot">
            <button class="btn btn-ghost" type="button" data-close>@L["Common_Cancel"]</button>
            <button class="btn btn-primary" id="n-save" type="button">@L["Common_Save"]</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var token = Ulak.csrf();
            var drivers = [];
            var i18n = {
                assign: '@L["Deliveries_Assign"]', assigned: '@L["Deliveries_Assigned"]',
                saved: '@L["Common_Saved"]', error: '@L["Common_Error"]'
            };
            var statusText = { Pending: '@L["Status_Pending"]', Delivered: '@L["Status_Delivered"]', Failed: '@L["Status_Failed"]' };
            var statusPill = { Pending: 'pending', Delivered: 'ok', Failed: 'danger' };

            var checkSvg = '<svg viewBox="0 0 24 24" fill="none"><path d="m5 13 5 5 9-11" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
            var addSvg = '<svg viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>';

            function filters() {
                return {
                    search: document.getElementById('f-search').value || null,
                    status: document.getElementById('f-status').value || null,
                    driverId: document.getElementById('f-driver').value || null
                };
            }

            function renderRow(r) {
                var proofCell = r.hasProof
                    ? '<span class="check-ok" title="@L["Delivery_HasProof"]">' + checkSvg + '</span>'
                    : (r.status === 'Pending'
                        ? '<button class="icon-btn js-assign" data-id="' + r.id + '" title="' + i18n.assign + '" type="button">' + addSvg + '</button>'
                        : '<span class="cell-muted">—</span>');
                return '<tr>' +
                    '<td class="cell-mono">' + Ulak.esc(r.orderRef) + '</td>' +
                    '<td class="cell-primary">' + Ulak.esc(r.recipientName) + '</td>' +
                    '<td class="cell-muted">' + Ulak.esc(r.addressText) + '</td>' +
                    '<td><span class="pill ' + (statusPill[r.status] || 'pending') + '">' +
                        (r.status === 'Delivered' ? checkSvg : '') + Ulak.esc(statusText[r.status] || r.status) + '</span></td>' +
                    '<td>' + Ulak.esc(r.assignedDriverName || '—') + '</td>' +
                    '<td>' + proofCell + '</td>' +
                    '<td class="cell-muted tabular">' + new Date(r.createdAtUtc).toLocaleDateString() + '</td>' +
                    '</tr>';
            }

            var table = Ulak.dataTable({
                body: '#deliveriesBody', foot: '.table-foot',
                url: '@Url.Action("Data", "Deliveries")',
                sort: 'CreatedAtUtc', desc: true, colspan: 7,
                filters: filters, render: renderRow,
                text: {
                    empty: '@L["Deliveries_Empty"]', error: i18n.error,
                    records: '@L["Common_RecordCount"]', prev: '@L["Common_Prev"]', next: '@L["Common_Next"]'
                }
            });

            document.getElementById('deliveriesBody').addEventListener('click', function (e) {
                var btn = e.target.closest('.js-assign');
                if (!btn) return;
                var id = btn.dataset.id;
                var driverId = window.prompt(
                    i18n.assign + '\n' + drivers.map(function (d) { return d.id + ' = ' + d.name; }).join('\n'), '');
                if (!driverId) return;
                jQuery.ajax({
                    url: '@Url.Action("Assign", "Deliveries")?id=' + id,
                    method: 'POST', contentType: 'application/json',
                    headers: { 'RequestVerificationToken': token },
                    data: JSON.stringify({ driverId: parseInt(driverId, 10) })
                }).done(function () { table.refresh(); })
                  .fail(function (x) { alert((x.responseJSON && x.responseJSON.message) || i18n.error); });
            });

            document.getElementById('btn-filter').addEventListener('click', function () { table.refresh(); });
            document.getElementById('f-search').addEventListener('keydown', function (e) { if (e.key === 'Enter') table.refresh(); });

            jQuery.getJSON('@Url.Action("Drivers", "Deliveries")').done(function (list) {
                drivers = list || [];
                var opts = drivers.map(function (d) { return '<option value="' + d.id + '">' + Ulak.esc(d.name) + '</option>'; }).join('');
                jQuery('#f-driver, #n-driver').append(opts);
            });

            var modal = Ulak.modal('modal-new');
            document.getElementById('btn-new').addEventListener('click', function () {
                document.getElementById('new-error').classList.add('hidden');
                ['n-orderRef', 'n-recipientName', 'n-recipientPhone', 'n-addressText', 'n-note'].forEach(function (id) { document.getElementById(id).value = ''; });
                document.getElementById('n-driver').value = '';
                modal.open();
            });
            document.getElementById('n-save').addEventListener('click', function () {
                var body = {
                    orderRef: document.getElementById('n-orderRef').value,
                    recipientName: document.getElementById('n-recipientName').value,
                    recipientPhone: document.getElementById('n-recipientPhone').value || null,
                    addressText: document.getElementById('n-addressText').value,
                    note: document.getElementById('n-note').value || null,
                    assignedDriverId: document.getElementById('n-driver').value ? parseInt(document.getElementById('n-driver').value, 10) : null
                };
                jQuery.ajax({
                    url: '@Url.Action("Create", "Deliveries")', method: 'POST', contentType: 'application/json',
                    headers: { 'RequestVerificationToken': token }, data: JSON.stringify(body)
                }).done(function () { modal.close(); table.refresh(); })
                  .fail(function (x) {
                      var el = document.getElementById('new-error');
                      el.textContent = (x.responseJSON && x.responseJSON.message) || i18n.error;
                      el.classList.remove('hidden');
                  });
            });
        })();
    </script>
}
