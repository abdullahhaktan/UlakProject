@model SignUpViewModel
@{
    ViewData["Title"] = L["SignUp_Title"].Value;
}

<div class="auth-wrap">
    <div class="auth-card wide">
        <div class="auth-brand">
            <svg class="mark" viewBox="0 0 24 24" fill="none"><path d="M4 8.5 12 4l8 4.5v7L12 20l-8-4.5v-7Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M4 8.5 12 13l8-4.5M12 13v7" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
            <span class="word">Ulak</span><span class="pod">POD</span>
        </div>
        <h1>@L["SignUp_Title"]</h1>
        <p class="lead">@L["SignUp_Lead"]</p>

        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="alert alert-danger">@Model.Error</div>
        }

        <form asp-action="SignUp" method="post">
            <label class="field-block">
                <span>@L["SignUp_CompanyName"]</span>
                <input asp-for="CompanyName" placeholder="@L["SignUp_CompanyPlaceholder"]" />
                <span asp-validation-for="CompanyName" class="field-error"></span>
            </label>
            <label class="field-block">
                <span>@L["SignUp_AdminName"]</span>
                <input asp-for="AdminName" placeholder="@L["SignUp_AdminPlaceholder"]" />
                <span asp-validation-for="AdminName" class="field-error"></span>
            </label>
            <label class="field-block">
                <span>@L["Login_Phone"]</span>
                <div class="phone-input">
                    <input class="phone-cc" inputmode="tel" aria-label="@L["Phone_CountryCode"]" />
                    <input class="phone-nat" inputmode="numeric" autocomplete="tel-national" placeholder="5xx xxx xx xx" />
                    <input type="hidden" asp-for="Phone" class="phone-full" autocomplete="username" />
                </div>
                <span asp-validation-for="Phone" class="field-error"></span>
            </label>
            <label class="field-block">
                <span>@L["Login_Password"]</span>
                <input asp-for="Password" type="password" autocomplete="new-password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </label>
            <button type="submit" class="btn btn-primary btn-block">@L["SignUp_Submit"]</button>
        </form>

        <div class="auth-foot">
            <p>@L["SignUp_HaveAccount"] <a asp-action="Login">@L["SignUp_LoginLink"]</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
