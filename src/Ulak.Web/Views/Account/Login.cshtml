@model LoginViewModel
@{
    ViewData["Title"] = L["Login_Title"].Value;
}

<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-brand">
            <svg class="mark" viewBox="0 0 24 24" fill="none"><path d="M4 8.5 12 4l8 4.5v7L12 20l-8-4.5v-7Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M4 8.5 12 13l8-4.5M12 13v7" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
            <span class="word">Ulak</span><span class="pod">POD</span>
        </div>
        <h1>@L["Login_Title"]</h1>
        <p class="lead">@L["Login_Subtitle"]</p>

        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="alert alert-danger">
                @(Model.Error == "OpsOnly" ? L["Login_OpsOnly"] : L["Login_Invalid"])
            </div>
        }

        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <label class="field-block">
                <span>@L["Login_Phone"]</span>
                <div class="phone-input">
                    <input class="phone-cc" inputmode="tel" aria-label="@L["Phone_CountryCode"]" />
                    <input class="phone-nat" inputmode="numeric" autocomplete="tel-national" placeholder="5xx xxx xx xx" />
                    <input type="hidden" asp-for="Phone" class="phone-full" autocomplete="username" />
                </div>
                <span asp-validation-for="Phone" class="field-error"></span>
            </label>
            <label class="field-block">
                <span>@L["Login_Password"]</span>
                <input asp-for="Password" type="password" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </label>
            <button type="submit" class="btn btn-primary btn-block">@L["Login_Submit"]</button>
        </form>

        <div class="auth-foot">
            <p>@L["Login_NoCompany"] <a asp-action="SignUp">@L["Login_SignUpLink"]</a></p>
            <p style="margin-top:6px">@L["Login_DemoHint"] <code>+905550001122 / Ops12345!</code></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
