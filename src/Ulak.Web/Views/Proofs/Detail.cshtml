@using Ulak.Shared.Proofs
@model ProofDetail
@{
    ViewData["Title"] = $"{L["Proof_Title"].Value} #{Model.Id}";
    var hasGps = Model.CapturedLat.HasValue && Model.CapturedLng.HasValue;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@L["Proof_Title"] #@Model.Id
        <span class="badge text-bg-@(Model.Status == "Delivered" ? "success" : "danger") align-middle">@Model.Status</span>
    </h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" href="@Url.Action("Pdf", "Proofs", new { id = Model.Id })">@L["Proof_DownloadPdf"]</a>
        <a class="btn btn-outline-secondary" asp-action="Index">@L["Common_Back"]</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card mb-3"><div class="card-body">
            <h2 class="h6 text-muted">@L["Proof_DeliveryInfo"]</h2>
            <dl class="row mb-0">
                <dt class="col-5">@L["Delivery_OrderRef"]</dt><dd class="col-7">@Model.OrderRef</dd>
                <dt class="col-5">@L["Delivery_Recipient"]</dt><dd class="col-7">@Model.RecipientName</dd>
                <dt class="col-5">@L["Delivery_Phone"]</dt><dd class="col-7">@Model.RecipientPhone</dd>
                <dt class="col-5">@L["Delivery_Address"]</dt><dd class="col-7">@Model.AddressText</dd>
                <dt class="col-5">@L["Common_Driver"]</dt><dd class="col-7">@Model.DriverName (@Model.DriverPhone)</dd>
                @if (!string.IsNullOrEmpty(Model.RecipientSignedName))
                {
                    <dt class="col-5">@L["Proof_SignedBy"]</dt><dd class="col-7">@Model.RecipientSignedName</dd>
                }
                @if (!string.IsNullOrEmpty(Model.FailureReason))
                {
                    <dt class="col-5">@L["Proof_FailureReason"]</dt><dd class="col-7 text-danger">@Model.FailureReason</dd>
                }
                <dt class="col-5">@L["Proof_CapturedAt"]</dt><dd class="col-7">@Model.CapturedAtUtc.ToString("u")</dd>
                <dt class="col-5">@L["Proof_SyncedAt"]</dt><dd class="col-7">@Model.SyncedAtUtc.ToString("u")</dd>
                @if (hasGps)
                {
                    <dt class="col-5">GPS</dt>
                    <dd class="col-7">
                        @Model.CapturedLat?.ToString("F6"), @Model.CapturedLng?.ToString("F6")
                        <a target="_blank" href="https://www.google.com/maps?q=@Model.CapturedLat,@Model.CapturedLng">@L["Proof_OpenMap"]</a>
                    </dd>
                }
            </dl>
        </div></div>

        @if (!string.IsNullOrEmpty(Model.SignatureUrl))
        {
            <div class="card mb-3"><div class="card-body">
                <h2 class="h6 text-muted">@L["Proof_Signature"]</h2>
                <img src="@Model.SignatureUrl" class="img-fluid border rounded bg-white" style="max-height: 200px;" alt="signature" />
            </div></div>
        }
    </div>

    <div class="col-lg-7">
        <div class="card mb-3"><div class="card-body">
            <h2 class="h6 text-muted">@L["Proof_Photos"] (@Model.Photos.Count)</h2>
            <div class="row g-2">
                @foreach (var photo in Model.Photos)
                {
                    <div class="col-6">
                        <a href="@photo.Url" target="_blank">
                            <img src="@photo.Url" class="img-fluid border rounded" alt="photo @photo.OrderIndex" />
                        </a>
                    </div>
                }
                @if (Model.Photos.Count == 0)
                {
                    <p class="text-muted small">@L["Proof_NoPhotos"]</p>
                }
            </div>
        </div></div>

        @if (hasGps)
        {
            <div class="card"><div class="card-body">
                <h2 class="h6 text-muted">@L["Proof_Location"]</h2>
                <div id="map" style="height: 260px;" class="border rounded"></div>
            </div></div>
        }
    </div>
</div>

@if (hasGps)
{
    @section Scripts {
        <script>
            // lightweight static-map fallback using OpenStreetMap embed
            const lat = @Model.CapturedLat, lng = @Model.CapturedLng;
            const d = 0.01;
            $("#map").html(
                `<iframe width="100%" height="100%" frameborder="0" style="border:0"
                   src="https://www.openstreetmap.org/export/embed.html?bbox=${lng-d}%2C${lat-d}%2C${lng+d}%2C${lat+d}&layer=mapnik&marker=${lat}%2C${lng}"></iframe>`);
        </script>
    }
}
