@using Ulak.Shared.Proofs
@model ProofDetail
@{
    ViewData["Title"] = $"{L["Proof_Title"].Value} #{Model.Id}";
    var hasGps = Model.CapturedLat.HasValue && Model.CapturedLng.HasValue;
    var isPickup = Model.ProofType == "Pickup";
    var failed = Model.Status == "Failed";
    var statusLabel = failed ? L["Status_Failed"].Value
        : isPickup ? L["Status_PickedUp"].Value : L["Status_Delivered"].Value;
    var typeLabel = isPickup ? L["ProofType_Pickup"].Value : L["ProofType_Delivery"].Value;
}

<a class="breadcrumb" asp-action="Index">
    <svg viewBox="0 0 24 24" fill="none"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    @L["Proofs_Title"]
</a>

<div class="page-head">
    <div>
        <h1>@L["Proof_Title"] #@Model.Id
            <span class="pill @(isPickup ? "pending" : "ok")" style="vertical-align:middle">@typeLabel</span>
            <span class="pill @(failed ? "danger" : isPickup ? "warn" : "ok")" style="vertical-align:middle">@statusLabel</span>
        </h1>
        <p class="sub">@string.Format(L["Proof_SubtitleFmt"].Value, Model.OrderRef)</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline" href="@Url.Action("Pdf", "Proofs", new { id = Model.Id })">
            <svg viewBox="0 0 24 24" fill="none"><path d="M12 4v11m0 0-4-4m4 4 4-4M5 19h14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            @L["Proof_DownloadPdf"]
        </a>
        <a class="btn btn-ghost" asp-action="Index">@L["Common_Back"]</a>
    </div>
</div>

<div class="detail-grid">
    <div class="detail-stack">
        <div class="card">
            <div class="card-head"><h2>@L["Proof_DeliveryInfo"]</h2></div>
            <dl class="info-list">
                <div class="info-row"><dt>@L["Delivery_OrderRef"]</dt><dd><span class="order-chip">@Model.OrderRef</span></dd></div>
                <div class="info-row"><dt>@L["Delivery_Recipient"]</dt><dd>@Model.RecipientName</dd></div>
                @if (!string.IsNullOrEmpty(Model.RecipientPhone))
                {
                    <div class="info-row"><dt>@L["Delivery_Phone"]</dt><dd class="mono">@Model.RecipientPhone</dd></div>
                }
                <div class="info-row"><dt>@L["Delivery_Address"]</dt><dd>@Model.AddressText</dd></div>
                <div class="info-row"><dt>@L["Common_Driver"]</dt><dd>@Model.DriverName <span class="cell-muted">· @Model.DriverPhone</span></dd></div>
                @if (!string.IsNullOrEmpty(Model.RecipientSignedName))
                {
                    <div class="info-row"><dt>@L["Proof_SignedBy"]</dt><dd class="mono">@Model.RecipientSignedName</dd></div>
                }
                @if (!string.IsNullOrEmpty(Model.FailureReason))
                {
                    <div class="info-row"><dt>@L["Proof_FailureReason"]</dt><dd class="fail">@Model.FailureReason</dd></div>
                }
                <div class="info-row"><dt>@L["Proof_CapturedAt"]</dt><dd class="mono">@Model.CapturedAtUtc.ToString("u")</dd></div>
                <div class="info-row"><dt>@L["Proof_SyncedAt"]</dt><dd class="mono">@Model.SyncedAtUtc.ToString("u")</dd></div>
                @if (hasGps)
                {
                    <div class="info-row">
                        <dt>GPS</dt>
                        <dd class="mono">
                            @Model.CapturedLat?.ToString("F6"), @Model.CapturedLng?.ToString("F6")
                            <a target="_blank" href="https://www.google.com/maps?q=@Model.CapturedLat,@Model.CapturedLng">@L["Proof_OpenMap"]</a>
                        </dd>
                    </div>
                }
            </dl>
        </div>

        @if (!string.IsNullOrEmpty(Model.SignatureUrl))
        {
            <div class="card">
                <div class="card-head"><h2>@L["Proof_Signature"]</h2></div>
                <div class="sig-pad"><img src="@Model.SignatureUrl" alt="signature" /></div>
                @if (!string.IsNullOrEmpty(Model.RecipientSignedName))
                {
                    <p class="sig-meta">@Model.RecipientSignedName</p>
                }
            </div>
        }
    </div>

    <div class="detail-stack">
        <div class="card">
            <div class="card-head"><h2>@L["Proof_Photos"] (@Model.Photos.Count)</h2></div>
            @if (Model.Photos.Count == 0)
            {
                <div class="card-body"><p class="cell-muted">@L["Proof_NoPhotos"]</p></div>
            }
            else
            {
                <div class="photo-grid">
                    @foreach (var photo in Model.Photos)
                    {
                        <a class="photo-frame" href="@photo.Url" target="_blank">
                            <img src="@photo.Url" alt="photo @photo.OrderIndex" />
                        </a>
                    }
                </div>
            }
        </div>

        @if (hasGps)
        {
            <div class="card">
                <div class="card-head"><h2>@L["Proof_Location"]</h2></div>
                <div class="card-body"><div id="map"></div></div>
            </div>
        }
    </div>
</div>

@if (hasGps)
{
    @section Scripts {
        <script>
            var lat = @Model.CapturedLat, lng = @Model.CapturedLng, d = 0.01;
            document.getElementById('map').innerHTML =
                '<iframe src="https://www.openstreetmap.org/export/embed.html?bbox=' +
                (lng - d) + '%2C' + (lat - d) + '%2C' + (lng + d) + '%2C' + (lat + d) +
                '&layer=mapnik&marker=' + lat + '%2C' + lng + '"></iframe>';
        </script>
    }
}
