{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=Ulak;User Id=sa;Password=Your_strong_Passw0rd!;TrustServerCertificate=True;Encrypt=False"
  },
  "Jwt": {
    "SigningKey": "local-dev-signing-key-please-override-this-with-32+chars",
    "Issuer": "ulak",
    "Audience": "ulak",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Storage": {
    "Endpoint": "http://localhost:9000",
    "PublicEndpoint": "http://localhost:9000",
    "AccessKey": "ulak",
    "SecretKey": "ulak-secret",
    "Bucket": "proofs",
    "PresignTtlMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:8081", "http://localhost:5173" ]
  },
  "AllowedHosts": "*"
}
