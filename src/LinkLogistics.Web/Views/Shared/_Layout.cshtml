@using System.Globalization
@{
    var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var otherCulture = culture == "tr" ? "en" : "tr";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="@culture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · LinkLogistics</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/devextreme/css/dx.common.css" />
    <link rel="stylesheet" href="~/lib/devextreme/css/dx.light.css" id="dx-theme" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/devextreme/js/dx.all.js"></script>
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
        <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">LinkLogistics <span class="fw-light">POD</span></a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">@L["Nav_Dashboard"]</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Deliveries" asp-action="Index">@L["Nav_Deliveries"]</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Proofs" asp-action="Index">@L["Nav_Proofs"]</a></li>
                </ul>
                <div class="d-flex align-items-center gap-3">
                    <a class="text-white-50 text-decoration-none small"
                       asp-controller="Account" asp-action="SetLanguage"
                       asp-route-culture="@otherCulture" asp-route-returnUrl="@returnUrl">@otherCulture.ToUpperInvariant()</a>
                    <span class="text-white-50 small">@User.Identity!.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-light">@L["Nav_Logout"]</button>
                    </form>
                </div>
            </div>
        }
    </div>
</nav>

<main class="container-fluid py-4">
    @RenderBody()
</main>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
